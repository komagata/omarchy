#!/bin/bash

# omarchy:summary=Show or set window borders: theme or none
# omarchy:args=[theme|none]
# omarchy:examples=omarchy hyprland borders | omarchy hyprland borders none

TOGGLES_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/toggles/hypr"

if (( $# == 0 )); then
  if [[ -f $TOGGLES_DIR/borders-none.lua ]]; then
    echo "none"
  else
    echo "theme"
  fi
  exit 0
fi

if (( $# != 1 )); then
  echo "Usage: omarchy-hyprland-borders [theme|none]" >&2
  exit 1
fi

case $1 in
  theme) LABEL=$(omarchy-i18n borders.followTheme) ;;
  none) LABEL=$(omarchy-i18n borders.none) ;;
  *)
    echo "Usage: omarchy-hyprland-borders [theme|none]" >&2
    exit 1
    ;;
esac

# Toggle files load after the theme and personal settings. Removing this flag
# restores their border width; window-no-gaps.lua still takes precedence.
if [[ $1 == "none" ]]; then
  mkdir -p "$TOGGLES_DIR" && cp "$OMARCHY_PATH/default/hypr/toggles/borders-none.lua" "$TOGGLES_DIR/borders-none.lua" || exit 1
else
  rm -f "$TOGGLES_DIR/borders-none.lua" || exit 1
fi

hyprctl reload >/dev/null || exit 1
omarchy-notification-send -g 󰘇 "$LABEL"
